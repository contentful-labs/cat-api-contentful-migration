# Contentful Management API personal access token
# Get yours at: https://app.contentful.com/account/profile/cma-tokens
CONTENTFUL_MANAGEMENT_TOKEN=your_cma_token_here

# Target Contentful space
CONTENTFUL_SPACE_ID=bbxbm9n86snf
CONTENTFUL_ENVIRONMENT_ID=master

# The Cat API key — DEMO-API-KEY works for the public breeds endpoint
# Get a free key at: https://thecatapi.com/
CAT_API_KEY=DEMO-API-KEY
